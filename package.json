{
  "name": "cdtn1-tranquocvuong-l4",
  "version": "0.2.0",
  "description": "Smart CRM Mekong Mobile - Luong L4: Phan cong ky thuat vien va lich hen",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:create": "node scripts/create-db.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:gen-seed": "node scripts/gen-seed-mekong.js",
    "token": "node scripts/token.js",
    "test": "jest",
    "test:db": "jest --runInBand --config jest.db.config.js",
    "db:reset": "node scripts/reset.js",
    "web:install": "npm ci --prefix web",
    "web:build": "npm run build --prefix web",
    "web:dev": "npm run dev --prefix web"
  },
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "jest": "^30.2.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/db/"
    ],
    "setupFiles": [
      "<rootDir>/tests/setup-env.js"
    ]
  }
}
