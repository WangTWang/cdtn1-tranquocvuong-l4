@startuml
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
left to right direction
skinparam packageStyle rectangle

actor "Quản lý trung tâm" as QLTT
actor "Kỹ thuật viên" as KTV
actor "Nhân viên tiếp nhận" as NVTN

rectangle "Hệ thống: Phân công kỹ thuật viên và lịch hẹn (luồng L4)" {
  usecase "UC1: Xem danh sách phiếu\nchờ phân công" as UC1
  usecase "UC2: Xem gợi ý\nkỹ thuật viên phù hợp" as UC2
  usecase "UC3: Phân công\nkỹ thuật viên cho phiếu" as UC3
  usecase "UC4: Đổi kỹ thuật viên\nkèm lý do" as UC4
  usecase "UC5: Xem phiếu được gán\ntheo hạn cam kết" as UC5
  usecase "UC6: Đặt lịch hẹn\ngiao – nhận máy" as UC6
  usecase "UC7: Kiểm tra trùng lịch\nkỹ thuật viên" as UC7
  usecase "UC8: Xem khối lượng công việc\ncủa kỹ thuật viên" as UC8
  usecase "UC9: Xem lịch hẹn\ncủa mình" as UC9

  UC3 .> UC2 : <<include>>
  UC6 .> UC7 : <<include>>
}

QLTT -- UC1
QLTT -- UC3
QLTT -- UC4
QLTT -- UC8
KTV -- UC5
KTV -- UC9
NVTN -- UC6
@enduml
