eft=5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="160" y="322" width="280" height="30" as="geometry"/></mxCell><mxCell id="WF27" value="TRUNG_CAP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=left;spacingLeft=5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="322" width="180" height="30" as="geometry"/></mxCell><mxCell id="WF28" value="3 / 5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=left;spacingLeft=5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="322" width="200" height="30" as="geometry"/></mxCell><mxCell id="WF29" value="6" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=left;spacingLeft=5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="322" width="200" height="30" as="geometry"/></mxCell><mxCell id="WF30" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;fontColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="372" width="22" height="22" as="geometry"/></mxCell><mxCell id="WF31" value="&lt;b&gt;Lỗi:&lt;/b&gt; Phiếu BH-000123/2026 đã được phân công cho Phạm Minh Khôi. Vui lòng tải lại danh sách." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="366" width="930" height="34" as="geometry"/></mxCell><mxCell id="WF32" value="Các thông báo khác hiện ở cùng vị trí: “Phiếu chưa được phân loại, chưa thể gợi ý kỹ thuật viên” · “Không có kỹ thuật viên phù hợp tại trung tâm” · “Phiếu đang ở trạng thái ĐÃ HỦY”" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="90" y="402" width="930" height="34" as="geometry"/></mxCell><mxCell id="WF33" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;fontColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="452" width="22" height="22" as="geometry"/></mxCell><mxCell id="WF34" value="Hủy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9d9d9;strokeColor=#000000;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="790" y="448" width="100" height="32" as="geometry"/></mxCell><mxCell id="WF35" value="Phân công" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9d9d9;strokeColor=#000000;fontStyle=1;fontSize=12;fillColor=#b3b3b3;" vertex="1" parent="1"><mxGeometry x="900" y="448" width="120" height="32" as="geometry"/></mxCell><mxCell id="WF36" value="&lt;b&gt;Ghi chú wireframe&lt;/b&gt;&lt;br&gt;① Thông tin phiếu chỉ đọc, lấy từ bảng ticket và bảng phụ trợ.&lt;br&gt;② Danh sách gợi ý do hệ thống tính (UC2, QT-08). “Số phiếu đang giữ” là số phiếu DA_PHAN_CONG hoặc DANG_XU_LY của kỹ thuật viên, tính bằng COUNT, không lưu thành cột.&lt;br&gt;③ Vùng thông báo lỗi cho các luồng ngoại lệ 2a, 3a, 5a, 5b của UC3. Khi có lỗi 2a hoặc 3a thì không hiện nút “Phân công”.&lt;br&gt;④ “Phân công” = lần bấm thứ 3 (chọn phiếu → chọn kỹ thuật viên → Phân công), đáp ứng NFR4. Hệ thống lưu ticket.technician_id, chuyển status MOI → DA_PHAN_CONG, thêm một dòng ticket_status_log và một dòng ticket_assignment_log trong cùng một transaction (NFR3)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="1000" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="WF3 Dat lich hen" name="WF3 Đặt lịch hẹn"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="WF2" value="&lt;b&gt;WIREFRAME 3 – Đặt lịch hẹn giao – nhận máy&lt;/b&gt; (UC6 kèm UC7 · US6 · FR7, FR8) – người dùng: Nhân viên tiếp nhận" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="30" as="geometry"/></mxCell><mxCell id="WF3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1000" height="440" as="geometry"/></mxCell><mxCell id="WF4" value="Smart CRM – Mekong Mobile &amp;nbsp;|&amp;nbsp; Đặt lịch hẹn giao – nhận máy" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#000000;align=left;spacingLeft=10;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1000" height="36" as="geometry"/></mxCell><mxCell id="WF5" value="Nguyễn Thị Lan (Tiếp nhận) · Trung tâm Quận 10" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;align=right;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="66" width="410" height="24" as="geometry"/></mxCell><mxCell id="WF6" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;fontColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="112" width="22" height="22" as="geometry"/></mxCell><mxCell id="WF7" value="&lt;b&gt;Phiếu bảo hành BH-000123/2026&lt;/b&gt; &amp;nbsp;·&amp;nbsp; Trạng thái: ĐÃ PHÂN CÔNG&lt;br&gt;Khách hàng: Nguyễn Thị Hoa &amp;nbsp;·&amp;nbsp; Số điện thoại: &lt;b&gt;090****567&lt;/b&gt; &amp;nbsp;·&amp;nbsp; Thiết bị: Mekong M5&lt;br&gt;Kỹ thuật viên: &lt;b&gt;Phạm Minh Khôi&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=6;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="90" y="108" width="930" height="74" as="geometry"/></mxCell><mxCell id="WF8" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;fontColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="204" width="22" height="22" as="geometry"/></mxCell><mxCell id="WF9" value="Loại lịch hẹn *" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;align=right;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="198" width="170" height="30" as="geometry"/></mxCell><mxCell id="WF10" value="(●) GIAO máy cho khách &amp;nbsp;&amp;nbsp;&amp;nbsp; ( ) NHẬN máy từ khách" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="198" width="500" height="30" as="geometry"/></mxCell><mxCell id="WF11" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;fontColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="244" width="22" height="22" as="geometry"/></mxCell><mxCell id="WF12" value="Bắt đầu *" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;align=right;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="238" width="170" height="30" as="geometry"/></mxCell><mxCell id="WF13" value="07/10/2026 &amp;nbsp; 09:00" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="238" width="240" height="30" as="geometry"/></mxCell><mxCell id="WF14" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;fontColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="284" width="22" height="22" as="geometry"/></mxCell><mxCell id="WF15" value="Kết thúc *" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;align=right;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="278" width="170" height="30" as="geometry"/></mxCell><mxCell id="WF16" value="07/10/2026 &amp;nbsp; 09:30" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="278" width="240" height="30" as="geometry"/></mxCell><mxCell id="WF17" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;fontColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="324" width="22" height="22" as="geometry"/></mxCell><mxCell id="WF18" value="Ghi chú" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;align=right;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="318" width="170" height="30" as="geometry"/></mxCell><mxCell id="WF19" value="Khách hẹn lấy máy buổi sáng" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="318" width="740" height="30" as="geometry"/></mxCell><mxCell id="WF20" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;fontColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="372" width="22" height="22" as="geometry"/></mxCell><mxCell id="WF21" value="&lt;b&gt;Lỗi:&lt;/b&gt; Kỹ thuật viên Phạm Minh Khôi đã có lịch hẹn 09:00–09:45 ngày 07/10/2026. Khung giờ trống gần nhất: từ 09:45." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="366" width="930" height="34" as="geometry"/></mxCell><mxCell id="WF22" value="Các thông báo khác hiện ở cùng vị trí: “Cần phân công kỹ thuật viên trước” · “Thời điểm kết thúc phải sau thời điểm bắt đầu” · “Không đặt lịch ở quá khứ” · “Chỉ đặt lịch từ thứ Hai đến thứ Bảy”" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="90" y="402" width="930" height="34" as="geometry"/></mxCell><mxCell id="WF23" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;fontColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="452" width="22" height="22" as="geometry"/></mxCell><mxCell id="WF24" value="Hủy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9d9d9;strokeColor=#000000;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="790" y="448" width="100" height="32" as="geometry"/></mxCell><mxCell id="WF25" value="Lưu lịch hẹn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9d9d9;strokeColor=#000000;fontStyle=1;fontSize=12;fillColor=#b3b3b3;" vertex="1" parent="1"><mxGeometry x="900" y="448" width="120" height="32" as="geometry"/></mxCell><mxCell id="WF26" value="&lt;b&gt;Ghi chú wireframe&lt;/b&gt;&lt;br&gt;① Thông tin phiếu chỉ đọc. Nhân viên tiếp nhận thấy số điện thoại dạng che (QT-15). Kỹ thuật viên lấy từ ticket.technician_id, không cho chọn lại ở đây.&lt;br&gt;②–⑤ Các trường nhập của lịch hẹn; dấu * là bắt buộc (NOT NULL trong bảng appointment).&lt;br&gt;⑥ Vùng thông báo lỗi cho các luồng ngoại lệ 1a, 2a, 2b, 3a của UC6. Dữ liệu đã nhập được giữ lại khi có lỗi.&lt;br&gt;⑦ “Lưu lịch hẹn” thêm một dòng vào bảng appointment sau khi kiểm tra trùng lịch (UC7, RB-02)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="1000" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>