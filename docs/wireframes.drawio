/></mxCell><mxCell id="WF38" value="Phân công" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9d9d9;strokeColor=#000000;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="936" y="182" width="94" height="26" as="geometry"/></mxCell><mxCell id="WF39" value="Phân công" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9d9d9;strokeColor=#000000;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="936" y="212" width="94" height="26" as="geometry"/></mxCell><mxCell id="WF40" value="Phân công" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9d9d9;strokeColor=#000000;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="936" y="242" width="94" height="26" as="geometry"/></mxCell><mxCell id="WF41" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;fontColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="292" width="22" height="22" as="geometry"/></mxCell><mxCell id="WF42" value="&amp;lt; Trang 1 / 1 &amp;gt; &amp;nbsp;&amp;nbsp; 20 phiếu mỗi trang" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="288" width="400" height="30" as="geometry"/></mxCell><mxCell id="WF43" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;fontColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="342" width="22" height="22" as="geometry"/></mxCell><mxCell id="WF44" value="Khi không còn phiếu ở trạng thái MỚI, bảng được thay bằng dòng:  &lt;b&gt;“Không có phiếu chờ phân công”&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="90" y="336" width="940" height="34" as="geometry"/></mxCell><mxCell id="WF45" value="&lt;b&gt;Ghi chú wireframe&lt;/b&gt;&lt;br&gt;① Bộ lọc cố định status = MOI, chỉ phiếu thuộc trung tâm của người đăng nhập (QT-14).&lt;br&gt;② Mỗi dòng là một phiếu bảo hành; phiếu có hạn cam kết sớm nhất nằm trên cùng. Quản lý thấy số điện thoại đầy đủ (QT-15).&lt;br&gt;③ Nút “Phân công” mở Wireframe 2 cho phiếu đó (UC3).&lt;br&gt;④ Phân trang ở tầng cơ sở dữ liệu để đạt NFR1.&lt;br&gt;⑤ Trạng thái rỗng theo tiêu chí chấp nhận US1 – AC2." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="1000" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="WF2 Phan cong KTV" name="WF2 Phân công kỹ thuật viên"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="WF2" value="&lt;b&gt;WIREFRAME 2 – Phân công kỹ thuật viên cho phiếu&lt;/b&gt; (UC3 kèm UC2 · US2, US3 · FR2, FR3, FR4) – người dùng: Quản lý trung tâm" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="30" as="geometry"/></mxCell><mxCell id="WF3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1000" height="440" as="geometry"/></mxCell><mxCell id="WF4" value="Smart CRM – Mekong Mobile &amp;nbsp;|&amp;nbsp; Phân công kỹ thuật viên" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#000000;align=left;spacingLeft=10;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1000" height="36" as="geometry"/></mxCell><mxCell id="WF5" value="Trần Thị Trâm (Quản lý) · Trung tâm Quận 10" st