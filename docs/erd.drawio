=Courier New;" vertex="1" parent="ER44"><mxGeometry x="0" y="138" width="410" height="22" as="geometry"/></mxCell><mxCell id="ER51" value="&lt;b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/b&gt;changed_at&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;TIMESTAMPTZ NOT NULL" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;fontFamily=Courier New;" vertex="1" parent="ER44"><mxGeometry x="0" y="160" width="410" height="22" as="geometry"/></mxCell><mxCell id="ER52" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endSize=12;startSize=12;strokeWidth=1.3;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="ER7" target="ER3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ER53" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;endSize=12;startSize=12;strokeWidth=1.3;fontSize=11;startArrow=ERzeroToOne;endArrow=ERzeroToMany;startFill=0;endFill=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ER8" target="ER20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ER54" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;endSize=12;startSize=12;strokeWidth=1.3;fontSize=11;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="ER14" target="ER27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ER55" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;endSize=12;startSize=12;strokeWidth=1.3;fontSize=11;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="ER14" target="ER35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ER56" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;endSize=12;startSize=12;strokeWidth=1.3;fontSize=11;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ER8" target="ER36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ER57" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;endSize=12;startSize=12;strokeWidth=1.3;fontSize=11;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="ER14" target="ER46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ER58" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;endSize=12;startSize=12;strokeWidth=1.3;fontSize=11;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ER8" target="ER48"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ER59" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;endSize=12;startSize=12;strokeWidth=1.3;fontSize=11;startArrow=ERzeroToOne;endArrow=ERzeroToMany;startFill=0;endFill=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ER8" target="ER47"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ER60" value="&lt;b&gt;CHÚ THÍCH KÝ PHÁP&lt;/b&gt;&lt;br&gt;—||  đúng một&lt;br&gt;—o|  không hoặc một&lt;br&gt;—o&amp;lt;  không hoặc nhiều&lt;br&gt;&lt;br&gt;PK = khóa chính · FK = khóa ngoại&lt;br&gt;&lt;b&gt;→ tên*&lt;/b&gt;: khóa ngoại trỏ tới BẢNG PHỤ TRỢ dùng chung, không vẽ ở đây (xem ô bên phải).&lt;br&gt;&lt;br&gt;Đọc ví dụ: mỗi &lt;b&gt;ticket&lt;/b&gt; có không hoặc một &lt;b&gt;technician&lt;/b&gt; (technician_id NULL khi phiếu ở trạng thái MOI); mỗi technician có không hoặc nhiều ticket." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="440" height="250" as="geometry"/></mxCell><mxCell id="ER61" value="&lt;b&gt;BẢNG PHỤ TRỢ DÙNG CHUNG&lt;/b&gt; (mức tối thiểu, có trong db/schema.sql)&lt;br&gt;• &lt;b&gt;employee&lt;/b&gt;(employee_id PK, full_name, role, center_id FK) – người dùng: QUAN_LY, KY_THUAT_VIEN, TIEP_NHAN&lt;br&gt;• &lt;b&gt;service_center&lt;/b&gt;(center_id PK, center_name)&lt;br&gt;• &lt;b&gt;issue_category&lt;/b&gt;(category_id PK, category_name UNIQUE)&lt;br&gt;• &lt;b&gt;customer&lt;/b&gt;(customer_id PK, full_name, phone UNIQUE)&lt;br&gt;• &lt;b&gt;device&lt;/b&gt;(device_id PK, customer_id FK, serial_no UNIQUE, model_name)&lt;br&gt;customer, device và việc tạo ticket thuộc luồng L2; L4 chỉ đọc." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1100" y="640" width="410" height="180" as="geometry"/></mxCell><mxCell id="ER62" value="&lt;b&gt;INDEX DỰ KIẾN&lt;/b&gt; (mỗi index phục vụ một truy vấn cụ thể)&lt;br&gt;• idx_ticket_center_status_due  ON ticket(center_id, status, due_date)  → FR1 · NFR1: danh sách phiếu chờ phân công dưới 2 giây&lt;br&gt;• idx_ticket_tech_status_due  ON ticket(technician_id, status, due_date)  → FR6 (phiếu của tôi) · FR2 (đếm số phiếu đang giữ)&lt;br&gt;• idx_skill_category_prof  ON technician_skill(category_id, proficiency)  → FR2 · QT-08: lọc tay nghề ≥ 3&lt;br&gt;• idx_appt_tech_start  ON appointment(technician_id, start_at)  → FR8: kiểm tra trùng lịch&lt;br&gt;• idx_status_log_ticket  ON ticket_status_log(ticket_id, changed_at)  → QT-06: xem lịch sử trạng thái&lt;br&gt;• idx_assign_log_ticket  ON ticket_assignment_log(ticket_id, changed_at)  → FR5 · QT-07: truy vết đổi kỹ thuật viên&lt;br&gt;&lt;br&gt;&lt;b&gt;RÀNG BUỘC CHÍNH:&lt;/b&gt; priority ∈ {CAO, TRUNG_BINH, THAP} · status theo Hình 6.2 · proficiency 1–5 · end_at &amp;gt; start_at · reason bắt buộc khi from_technician_id khác NULL (QT-07) · phiếu DA_PHAN_CONG/DANG_XU_LY phải có technician_id.&lt;br&gt;&lt;b&gt;KHÔNG lưu giá trị tính được:&lt;/b&gt; “số phiếu đang giữ” tính bằng COUNT trên ticket, không có cột riêng." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="1470" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>