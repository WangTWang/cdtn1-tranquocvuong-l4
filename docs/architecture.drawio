<mxfile host="app.diagrams.net" agent="draw.io" version="24.7.17"><diagram id="Kien truc L4" name="Kien truc L4"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="920" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Ki2" value="&lt;b&gt;SƠ ĐỒ KIẾN TRÚC PHÂN LỚP&lt;/b&gt;&lt;br&gt;Hệ thống: Phân công kỹ thuật viên và lịch hẹn (luồng L4, track SE)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;align=center;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1000" height="44" as="geometry"/></mxCell><mxCell id="Ki3" value="Người dùng (trình duyệt): Quản lý trung tâm · Kỹ thuật viên · Nhân viên tiếp nhận" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;align=center;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1000" height="22" as="geometry"/></mxCell><mxCell id="Ki4" value="LỚP TRÌNH BÀY (Presentation)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;strokeWidth=2;fillColor=#dae8fc;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="84" width="1000" height="236" as="geometry"/></mxCell><mxCell id="Ki5" value="Màn hình (React):" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="52" y="112" width="200" height="20" as="geometry"/></mxCell><mxCell id="Ki6" value="[ Danh sách phiếu&lt;br&gt;chờ phân công ]" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="134" width="225" height="46" as="geometry"/></mxCell><mxCell id="Ki7" value="[ Phân công&lt;br&gt;kỹ thuật viên ]" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="305" y="134" width="225" height="46" as="geometry"/></mxCell><mxCell id="Ki8" value="[ Phiếu được gán&lt;br&gt;của tôi ]" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="550" y="134" width="225" height="46" as="geometry"/></mxCell><mxCell id="Ki9" value="[ Đặt lịch hẹn&lt;br&gt;giao – nhận máy ]" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="795" y="134" width="225" height="46" as="geometry"/></mxCell><mxCell id="Ki10" value="↓  HTTP + JSON  (hợp đồng API: docs/api-contract.md, endpoint E1–E6)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="184" width="960" height="22" as="geometry"/></mxCell><mxCell id="Ki11" value="Controller (Express):" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="52" y="206" width="200" height="20" as="geometry"/></mxCell><mxCell id="Ki12" value="TicketController&lt;br&gt;E1, E5" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="228" width="306" height="42" as="geometry"/></mxCell><mxCell id="Ki13" value="AssignmentController&lt;br&gt;E2, E3, E4" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="387" y="228" width="306" height="42" as="geometry"/></mxCell><mxCell id="Ki14" value="AppointmentController&lt;br&gt;E6" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="714" y="228" width="306" height="42" as="geometry"/></mxCell><mxCell id="Ki15" value="Nhận request, kiểm định dạng dữ liệu, trả mã HTTP. KHÔNG chứa quy tắc nghiệp vụ, KHÔNG truy vấn dữ liệu trực tiếp." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="274" width="960" height="36" as="geometry"/></mxCell><mxCell id="Ki16" value="↓  gọi hàm của Service (dữ liệu đã kiểm định dạng + thông tin người gọi: vai trò, trung tâm)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="322" width="1000" height="26" as="geometry"/></mxCell><mxCell id="Ki17" value="LỚP NGHIỆP VỤ (Service)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;strokeWidth=2;fillColor=#d5e8d4;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="1000" height="176" as="geometry"/></mxCell><mxCell id="Ki18" value="&lt;b&gt;TicketQueryService&lt;/b&gt;&lt;br&gt;Danh sách phiếu theo trung tâm của người gọi (QT-14); che số điện thoại khách (QT-15)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="225" height="100" as="geometry"/></mxCell><mxCell id="Ki19" value="&lt;b&gt;SuggestionService&lt;/b&gt;&lt;br&gt;Gợi ý kỹ thuật viên: cùng trung tâm, đang làm việc, tay nghề ≥ 3 (QT-08); xếp theo số phiếu đang giữ" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="305" y="380" width="225" height="100" as="geometry"/></mxCell><mxCell id="Ki20" value="&lt;b&gt;AssignmentService&lt;/b&gt;&lt;br&gt;Phân công / đổi kỹ thuật viên trong MỘT transaction; chuyển trạng thái và ghi lịch sử (QT-06, QT-07, RB-01)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="550" y="380" width="225" height="100" as="geometry"/></mxCell><mxCell id="Ki21" value="&lt;b&gt;AppointmentService&lt;/b&gt;&lt;br&gt;Tạo lịch hẹn; kiểm tra trùng lịch và thời gian hợp lệ (RB-02, RB-03)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="795" y="380" width="225" height="100" as="geometry"/></mxCell><mxCell id="Ki22" value="&amp;gt;&amp;gt;&amp;gt; TOÀN BỘ quy tắc nghiệp vụ (QT, RB) nằm trong lớp này &amp;lt;&amp;lt;&amp;lt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="490" width="960" height="26" as="geometry"/></mxCell><mxCell id="Ki23" value="↓  gọi qua giao diện Repository (Service không biết câu lệnh SQL)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="528" width="1000" height="26" as="geometry"/></mxCell><mxCell id="Ki24" value="LỚP TRUY CẬP DỮ LIỆU (Repository)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;strokeWidth=2;fillColor=#ffe6cc;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="556" width="1000" height="124" as="geometry"/></mxCell><mxCell id="Ki25" value="TicketRepository" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="586" width="225" height="38" as="geometry"/></mxCell><mxCell id="Ki26" value="TechnicianRepository" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="305" y="586" width="225" height="38" as="geometry"/></mxCell><mxCell id="Ki27" value="TicketLogRepository" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="550" y="586" width="225" height="38" as="geometry"/></mxCell><mxCell id="Ki28" value="AppointmentRepository" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="795" y="586" width="225" height="38" as="geometry"/></mxCell><mxCell id="Ki29" value="Đọc và ghi dữ liệu, che giấu chi tiết SQL. KHÔNG chứa quy tắc nghiệp vụ." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="634" width="960" height="30" as="geometry"/></mxCell><mxCell id="Ki30" value="↓  SQL" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="682" width="1000" height="26" as="geometry"/></mxCell><mxCell id="Ki31" value="LỚP LƯU TRỮ – PostgreSQL 16" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="1000" height="96" as="geometry"/></mxCell><mxCell id="Ki32" value="6 bảng cốt lõi: &lt;b&gt;ticket&lt;/b&gt;, &lt;b&gt;technician&lt;/b&gt;, &lt;b&gt;technician_skill&lt;/b&gt;, &lt;b&gt;ticket_status_log&lt;/b&gt;, &lt;b&gt;ticket_assignment_log&lt;/b&gt;, &lt;b&gt;appointment&lt;/b&gt;&lt;br&gt;Bảng phụ trợ dùng chung: employee, service_center, issue_category, customer, device&lt;br&gt;Bảo đảm toàn vẹn bằng khóa ngoại, NOT NULL, UNIQUE, CHECK (xem docs/erd.drawio và db/schema.sql)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="736" width="960" height="62" as="geometry"/></mxCell><mxCell id="Ki33" value="&lt;b&gt;CHÚ THÍCH:&lt;/b&gt; [ ] = màn hình · ô trắng = thành phần · ↓ = hướng phụ thuộc MỘT CHIỀU (lớp trên gọi lớp dưới, lớp dưới không gọi ngược) · nhãn trên mũi tên = cách hai lớp trao đổi.&lt;br&gt;&lt;b&gt;NGOÀI PHẠM VI (WON'T):&lt;/b&gt; tiếp nhận và phân loại phiếu (L2) · kho linh kiện (L5) · tự động phân công không cần duyệt · gửi SMS/Zalo nhắc lịch hẹn · khách tự đặt lịch trực tuyến." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="818" width="1000" height="76" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>